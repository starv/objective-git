#!/bin/sh

set -e

ROOT_PATH=$(cd "$(dirname "$0")/.." && pwd)
EXTERNAL_BUILD_PATH="${ROOT_PATH}/External/build"

# Xcode GUI Run Script phases get a minimal launchd PATH that does not
# include Homebrew's bin directory (nor, on Apple Silicon, does it include
# /opt/homebrew/bin where `brew` itself lives), so `brew --prefix` cannot be
# relied upon to resolve. Seed a hardcoded fallback first, then opportunistically
# widen it using brew's actual prefix if brew happens to be resolvable.
PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
if command -v brew >/dev/null 2>&1; then
    PATH="$(brew --prefix)/bin:$PATH"
fi

if [ "${EXTERNAL_BUILD_PATH}/lib/libssh2.a" -nt "${ROOT_PATH}/External/libssh2" ]
then
    echo "No update needed."
    exit 0
fi

cd "${ROOT_PATH}/External/libssh2"

if [ -d "build" ]; then
    rm -rf "build"
fi

mkdir build
cd build

cmake -DBUILD_SHARED_LIBS:BOOL=OFF \
    -DBUILD_STATIC_LIBS:BOOL=ON \
    -DBUILD_EXAMPLES:BOOL=OFF \
    -DBUILD_TESTING:BOOL=OFF \
    -DCRYPTO_BACKEND=OpenSSL \
    -DOPENSSL_ROOT_DIR="${EXTERNAL_BUILD_PATH}" \
    -DOPENSSL_USE_STATIC_LIBS=TRUE \
    -DCMAKE_PREFIX_PATH="${EXTERNAL_BUILD_PATH}" \
    -DCMAKE_INSTALL_PREFIX="${EXTERNAL_BUILD_PATH}" \
    -DCMAKE_OSX_ARCHITECTURES=arm64 \
    -DCMAKE_OSX_DEPLOYMENT_TARGET=15.0 \
    ..
cmake --build . --target install

echo "libssh2 has been updated."
